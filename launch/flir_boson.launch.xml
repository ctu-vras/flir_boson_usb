<?xml version="1.0"?>
<!-- ROS 2 launch file. -->
<launch>
  <arg name="namespace" default="flir_boson"/>
  <arg name="component_container" default="$(var namespace)_container" />
  <arg name="run_component_container" default="true" />

  <arg name="rectify" default="false" />

  <arg name="frame_id" default="boson_camera"/>
  <arg name="dev" default="/dev/video0" description="the linux file descriptor location for the camera"/>
  <arg name="frame_rate" default="30.0" description="V4L2 polling rate in Hz, typical Boson hardware rates are 9, 30 or 60"/>
  <arg name="video_mode" default="YUV" description="valid values are YUV or RAW16"/>
  <arg name="zoom_enable" default="false"/>
  <arg name="publish_color" default="false"/>
  <arg name="raw16_agc_low_pct" default="1.0"
       description="percentile clipping of the RAW16 software AGC, valid range [0, 50)"/>
  <arg name="raw16_agc_high_pct" default="1.0"
       description="percentile clipping of the RAW16 software AGC, valid range [0, 50)"/>
  <arg name="sensor_type" default="Boson_640" description="valid values are Boson_320 or Boson_640"/>
  <arg name="camera_info_url" default=""
       description="location of the camera calibration file, empty publishes uncalibrated CameraInfo"/>
  <arg name="min_temp" default="20" description="min temperature for normalization"/>
  <arg name="max_temp" default="50" description="max temperature for normalization"/>

  <group>
    <push_ros_namespace namespace="$(var namespace)" />
    <node pkg="rclcpp_components" exec="component_container_mt" name="$(var component_container)"
          output="screen" respawn="true" if="$(var run_component_container)">
    </node>

    <load_composable_node target="$(var namespace)/$(var component_container)">
      <composable_node name="flir_boson_usb_node" pkg="flir_boson_usb" plugin="flir_boson_usb::BosonCamera">
        <param name="frame_id" type="str" value="$(var frame_id)"/>
        <param name="dev" type="str" value="$(var dev)"/>
        <param name="frame_rate" type="float" value="$(var frame_rate)"/>
        <param name="video_mode" type="str" value="$(var video_mode)"/>
        <param name="zoom_enable" type="bool" value="$(var zoom_enable)"/>
        <param name="publish_color" type="bool" value="$(var publish_color)"/>
        <param name="raw16_agc_low_pct" type="float" value="$(var raw16_agc_low_pct)"/>
        <param name="raw16_agc_high_pct" type="float" value="$(var raw16_agc_high_pct)"/>
        <param name="sensor_type" type="str" value="$(var sensor_type)"/>
        <param name="camera_info_url" type="str" value="$(var camera_info_url)"/>
        <param name="min_temp_limit" type="int" value="$(var min_temp)"/>
        <param name="max_temp_limit" type="int" value="$(var max_temp)"/>
      </composable_node>
    </load_composable_node>

    <group if="$(var rectify)">
      <load_composable_node target="$(var namespace)/$(var component_container)">
        <composable_node name="rectify_raw" pkg="image_proc" plugin="image_proc::RectifyNode">
          <remap from="image_mono" to="image_raw"/>
        </composable_node>
      </load_composable_node>

      <group if="$(var publish_color)">
        <load_composable_node target="$(var namespace)/$(var component_container)">
          <composable_node name="rectify_8" pkg="image_proc" plugin="image_proc::RectifyNode">
            <remap from="image_mono" to="image8"/>
            <remap from="image_rect" to="image8_rect"/>
          </composable_node>

          <composable_node name="rectify_8_norm" pkg="image_proc" plugin="image_proc::RectifyNode">
            <remap from="image_mono" to="image8_norm"/>
            <remap from="image_rect" to="image8_norm_rect"/>
          </composable_node>

          <composable_node name="rectify_heatmap" pkg="image_proc" plugin="image_proc::RectifyNode">
            <remap from="image_mono" to="image_heatmap"/>
            <remap from="image_rect" to="image_heatmap_rect"/>
          </composable_node>
        </load_composable_node>
      </group>
    </group>
  </group>
</launch>
