<!-- ROS 1 launch file for a Boson 320 sensor. -->
<launch>
  <arg name="sensor_type" default="Boson_320"/>

  <include file="$(dirname)/flir_boson.launch" pass_all_args="true">
    <arg name="sensor_type" value="$(arg sensor_type)"/>
  </include>
</launch>
