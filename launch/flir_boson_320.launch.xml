<!-- ROS 2 launch file for a Boson 320 sensor. -->
<launch>
  <arg name="sensor_type" default="Boson_320"/>

  <include file="$(find-pkg-share flir_boson_usb)/launch/flir_boson.launch.py">
    <arg name="sensor_type" value="$(var sensor_type)"/>
  </include>
</launch>
