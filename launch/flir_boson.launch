<!-- ROS 1 launch file. -->
<launch>
  <arg name="namespace" default="flir_boson"/>
  <arg name="nodelet_manager" default="" />
  <arg name="run_nodelet_manager" default="false" />

  <arg name="rectify" default="false" />

  <arg name="frame_id" default="boson_camera" doc="Frame used in header.frame_id"/>
  <arg name="dev" default="/dev/video0" doc="the linux file descriptor location for the camera"/>
  <arg name="sensor_type" default="Boson_640" doc="Physical sensor array size. Boson_320 or Boson_640. The driver cross-checks this against the V4L2-negotiated width and refuses to start on a mismatch."/>
  <arg name="frame_rate" default="30.0" doc="Frame rate of the camera. Only 9.0/30.0/60.0 supported."/>
  <arg name="queue_size" default="1" doc="Size of the publisher queues (the keep_last depth) of every topic the node publishes."/>
  <arg name="video_mode" default="YUV" doc="Camera image format. YUV: camera-side AGC (mono8/bgr8, low CPU). RAW16: raw 16-bit thermal counts (mono16, no camera processing). The visual topics only exist in this mode."/>
  <arg name="zoom_enable" default="false" doc="Digital 2x upscale (320x256 -> 640x512) of the published image. Only available on Boson320 cameras."/>
  <arg name="yuv_color" default="false" doc="In YUV mode, publishes image_raw as bgr8 instead of mono8. Use this if a color palette (e.g., Rainbow) is enabled via the FLIR GUI."/>
  <arg name="agc_mode" default="auto_range" doc="Content of the image_visual topic. none: no visual topic at all. fixed_range: stretch the temperature limits given by agc_fixed_min_temp/agc_fixed_max_temp. auto_range: stretch the percentiles given by agc_auto_low_pct/agc_auto_high_pct."/>
  <arg name="agc_auto_low_pct" default="1.0"
       doc="Bottom-tail clip percentage of the auto_range AGC (e.g. 1.0 discards the darkest 1% of pixels before linear stretch). Only honoured in agc_mode:=auto_range. Valid range [0, 50)."/>
  <arg name="agc_auto_high_pct" default="1.0"
       doc="Top-tail clip percentage of the auto_range AGC (e.g. 1.0 discards the brightest 1% of pixels before linear stretch). Only honoured in agc_mode:=auto_range. Valid range [0, 50)."/>
  <arg name="agc_norm" default="false"
       doc="Renormalise image_visual to the observed frame bounds widened by agc_norm_margin, on top of whichever agc_mode produced the bounds."/>
  <arg name="agc_norm_margin" default="20.0"
       doc="How much wider the observed bounds are taken when agc_norm is on, in grey levels of the active stretch."/>
  <arg name="heatmap_mode" default="none" doc="Content of the image_heatmap topic. none: no heatmap topic. visual: colourise image_visual. Requires an agc_mode other than none."/>
  <arg name="overlay_mode" default="min_max_ptr" doc="What is stamped on image_heatmap. none: nothing. min_max_ptr: the minimum, maximum and probe reading text and the probe marker. min_max: the minimum and maximum reading text only. ptr: the probe reading text and the probe marker. Printed in the unit of temp_mode (in raw counts for a non-radiometric camera). Can be changed while the node runs."/>
  <arg name="colormap" default="jet" doc="Colour palette image_heatmap is painted with, e.g. jet, parula, viridis, inferno, hot, turbo. Only honoured when a heatmap is published."/>
  <arg name="temp_mode" default="none" doc="Unit of the image_temp topic. none: no temperature topic. c, k, f: degrees Celsius, Kelvin and Fahrenheit as 32-bit floats. centi_c, centi_k, centi_f: the same units in hundredths as 16-bit integers. Only offered for radiometric cameras."/>
  <arg name="radiometric" default="auto" doc="Whether the camera can map the raw counts to absolute temperatures. auto: match the device identification against radiometric_patterns. true/false: override the detection."/>
  <arg name="camera_info_url" default=""
       doc="Camera calibration file URL (file:// or package://). Empty publishes uncalibrated CameraInfo."/>
  <arg name="temp_ptr_x" default="319" doc="X coord of the temperature probe point, i.e. the point of the ptr_temp reading."/>
  <arg name="temp_ptr_y" default="255" doc="Y coord of the temperature probe point, i.e. the point of the ptr_temp reading."/>
  <arg name="agc_fixed_min_temp" default="20" doc="Lower bound of the fixed_range stretch in degrees Celsius."/>
  <arg name="agc_fixed_max_temp" default="50" doc="Upper bound of the fixed_range stretch in degrees Celsius."/>

  <arg name="nodelet_manager_arg" value="standalone" if="$(eval nodelet_manager == '' and not run_nodelet_manager)" />
  <arg name="nodelet_manager_arg" value="load" if="$(eval nodelet_manager != '' or run_nodelet_manager)" />
  <arg name="nodelet_manager_name" value="" if="$(eval nodelet_manager == '' and not run_nodelet_manager)" />
  <arg name="nodelet_manager_name" value="$(arg nodelet_manager)" if="$(eval nodelet_manager != '')" />
  <arg name="nodelet_manager_name" value="$(arg namespace)_manager"
       if="$(eval nodelet_manager == '' and run_nodelet_manager)" />

  <group ns="$(arg namespace)">
    <node name="$(arg nodelet_manager_name)" pkg="nodelet" type="nodelet" args="manager" output="screen"
          if="$(arg run_nodelet_manager)" />

    <node name="flir_boson_usb_node" pkg="nodelet" type="nodelet"
          args="$(arg nodelet_manager_arg) flir_boson_usb/BosonCamera $(arg nodelet_manager_name)" output="screen">
      <param name="frame_id" type="str" value="$(arg frame_id)"/>
      <param name="dev" type="str" value="$(arg dev)"/>
      <param name="frame_rate" type="double" value="$(arg frame_rate)"/>
      <param name="queue_size" type="int" value="$(arg queue_size)"/>
      <param name="video_mode" type="str" value="$(arg video_mode)"/>
      <param name="zoom_enable" type="bool" value="$(arg zoom_enable)"/>
      <param name="yuv_color" type="bool" value="$(arg yuv_color)"/>
      <param name="agc_mode" type="str" value="$(arg agc_mode)"/>
      <param name="agc_auto_low_pct" type="double" value="$(arg agc_auto_low_pct)"/>
      <param name="agc_auto_high_pct" type="double" value="$(arg agc_auto_high_pct)"/>
      <param name="agc_norm" type="bool" value="$(arg agc_norm)"/>
      <param name="agc_norm_margin" type="double" value="$(arg agc_norm_margin)"/>
      <param name="heatmap_mode" type="str" value="$(arg heatmap_mode)"/>
      <param name="overlay_mode" type="str" value="$(arg overlay_mode)"/>
      <param name="colormap" type="str" value="$(arg colormap)"/>
      <param name="temp_mode" type="str" value="$(arg temp_mode)"/>
      <param name="radiometric" type="str" value="$(arg radiometric)"/>
      <param name="sensor_type" type="str" value="$(arg sensor_type)"/>
      <param name="camera_info_url" type="str" value="$(arg camera_info_url)"/>
      <param name="temp_ptr_x" type="int" value="$(arg temp_ptr_x)"/>
      <param name="temp_ptr_y" type="int" value="$(arg temp_ptr_y)"/>
      <param name="agc_fixed_min_temp" type="int" value="$(arg agc_fixed_min_temp)"/>
      <param name="agc_fixed_max_temp" type="int" value="$(arg agc_fixed_max_temp)"/>
    </node>

    <group if="$(arg rectify)">
      <node pkg="nodelet" type="nodelet" name="rectify_raw"
            args="$(arg nodelet_manager_arg) image_proc/rectify $(arg nodelet_manager_name)">
        <remap from="image_mono" to="image_raw"/>
      </node>

      <node pkg="nodelet" type="nodelet" name="rectify_visual" if="$(eval video_mode == 'RAW16' and agc_mode != 'none')"
            args="$(arg nodelet_manager_arg) image_proc/rectify $(arg nodelet_manager_name)">
        <remap from="image_mono" to="image_visual"/>
        <remap from="image_rect" to="image_visual_rect"/>
      </node>

      <node pkg="nodelet" type="nodelet" name="rectify_heatmap" if="$(eval video_mode == 'RAW16' and heatmap_mode != 'none')"
            args="$(arg nodelet_manager_arg) image_proc/rectify $(arg nodelet_manager_name)">
        <remap from="image_mono" to="image_heatmap"/>
        <remap from="image_rect" to="image_heatmap_rect"/>
      </node>

      <node pkg="nodelet" type="nodelet" name="rectify_temp" if="$(eval video_mode == 'RAW16' and temp_mode != 'none')"
            args="$(arg nodelet_manager_arg) image_proc/rectify $(arg nodelet_manager_name)">
        <remap from="image_mono" to="image_temp"/>
        <remap from="image_rect" to="image_temp_rect"/>
      </node>
    </group>
  </group>
</launch>
